<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fitsSystemWindows="true">

    <!-- Cyber Matrix Digital Rain Animation Layer -->
    <com.vxxtebot.MatrixRainView
        android:id="@+id/mainMatrixRain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.22" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Top Cyber Security Terminal Banner -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/headerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke_glow"
            app:strokeWidth="1.5dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/headerIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_cyber_shield"
                        android:background="@drawable/drawable_status_bg"
                        android:padding="6dp"
                        android:contentDescription="@string/app_name" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/appTitleText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VXXTA // HACKER X"
                            android:textColor="@color/primary"
                            android:fontFamily="monospace"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/appTaglineText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="CYBER PROTOCOL • @NawabKingMods"
                            android:textColor="@color/text_secondary"
                            android:fontFamily="monospace"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnRefreshConnection"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_refresh"
                        android:contentDescription="@string/btn_retry"
                        app:tint="@color/primary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/card_stroke" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="[ROOT@TUNNEL:~]# SECURE_PORT // 443_SSL_TLS"
                    android:textColor="@color/text_tertiary"
                    android:fontFamily="monospace"
                    android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Connection Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/status_blue_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/status_blue_stroke"
            app:strokeWidth="1.2dp"
            app:layout_constraintTop_toBottomOf="@id/headerCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/connectionStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/connection_checking"
                    android:textColor="@color/status_blue_text"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/connectionDetailText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Establishing encrypted handshake with @NawabKingMods..."
                    android:textColor="@color/text_secondary"
                    android:fontFamily="monospace"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Input Section Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/inputCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1.2dp"
            app:layout_constraintTop_toBottomOf="@id/statusCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="[>]"
                        android:textColor="@color/primary"
                        android:fontFamily="monospace"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="TARGET PAYLOAD INJECTION"
                        android:textColor="@color/text_primary"
                        android:fontFamily="monospace"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Target: Forward phone payload to @NawabKingMods"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="monospace"
                    android:textSize="11sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/phoneInputLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/phone_hint"
                    app:boxBackgroundColor="@color/cyber_code_bg"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxStrokeColor="@color/primary"
                    app:boxStrokeWidth="1.5dp"
                    app:hintTextColor="@color/primary"
                    app:helperText="@string/phone_helper"
                    app:helperTextTextColor="@color/text_tertiary"
                    app:startIconDrawable="@drawable/ic_phone"
                    app:startIconTint="@color/primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/phoneInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:text="+"
                        android:textColor="@color/text_primary"
                        android:fontFamily="monospace"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/submitButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="@color/primary"
                    android:enabled="false"
                    android:text="@string/btn_submit"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:fontFamily="monospace"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_send"
                    app:iconGravity="textStart"
                    app:iconTint="@color/black" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Loading / Waiting Card (Visible when sending or polling) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/loadingLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/accent"
            app:strokeWidth="1.5dp"
            app:layout_constraintTop_toBottomOf="@id/inputCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="18dp">

                <ProgressBar
                    android:id="@+id/loadingProgressBar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:indeterminateTint="@color/primary" />

                <TextView
                    android:id="@+id/loadingStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/status_sending"
                    android:textColor="@color/primary"
                    android:fontFamily="monospace"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAlignment="center" />

                <TextView
                    android:id="@+id/loadingDetailText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Scanning incoming telegram replies..."
                    android:textColor="@color/text_secondary"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textAlignment="center" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Reply Section Card (Visible when reply received) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/replyLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/reply_card_bg"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/reply_card_stroke"
            app:strokeWidth="1.5dp"
            app:layout_constraintTop_toBottomOf="@id/loadingLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_reply"
                        app:tint="@color/reply_accent"
                        android:contentDescription="Reply Icon" />

                    <TextView
                        android:id="@+id/replyHeaderTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/reply_received_title"
                        android:textColor="@color/reply_accent"
                        android:fontFamily="monospace"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/replyTimeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Just now"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="monospace"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/card_stroke_cyan" />

                <TextView
                    android:id="@+id/replySenderText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Channel: @NawabKingMods • From: User"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Reply Message Content Block -->
                <TextView
                    android:id="@+id/replyContentText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/drawable_terminal_codebox"
                    android:padding="14dp"
                    android:text="[DECRYPTED MESSAGE CONTENT]"
                    android:textColor="@color/text_terminal"
                    android:fontFamily="monospace"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp" />

                <!-- Copy Reply Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyReply"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/status_green_bg"
                    android:text="📋 COPY DECRYPTED MESSAGE"
                    android:textAllCaps="false"
                    android:textColor="@color/status_green_text"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_copy"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/status_green_text"
                    app:strokeColor="@color/status_green_stroke"
                    app:strokeWidth="1.2dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Status Bar Description -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/status_ready"
            android:textColor="@color/text_tertiary"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/replyLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- History Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/historyCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1.2dp"
            app:layout_constraintTop_toBottomOf="@id/statusText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_history"
                        app:tint="@color/primary"
                        android:contentDescription="History" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/history_title"
                        android:textColor="@color/text_primary"
                        android:fontFamily="monospace"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/historyCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 sent"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="monospace"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearHistory"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/btn_clear_history"
                        android:textAllCaps="false"
                        android:textColor="@color/status_red_text"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:visibility="gone"
                        app:icon="@drawable/ic_delete"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp"
                        app:iconSize="12dp"
                        app:iconTint="@color/status_red_text" />
                </LinearLayout>

                <TextView
                    android:id="@+id/historyEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/history_empty"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="monospace"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/historyContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
</FrameLayout>
